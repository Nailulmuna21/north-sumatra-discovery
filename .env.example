APP_NAME="North Sumatra Discovery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
# Buat dulu database kosong, lalu sesuaikan nilai di bawah ini.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=north_sumatra_discovery
DB_USERNAME=root
DB_PASSWORD=

# --- Session, cache, & antrean memakai database ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Media beranda (opsional; kosong = tampil ilustrasi) ---
# Isi dengan URL penuh video .mp4 dari hosting mana saja, contoh:
#   EDITORIAL_TOR_TOR_VIDEO_URL=https://contoh.com/tor-tor.mp4
HERO_VIDEO_URL=
HERO_POSTER_URL=
EDITORIAL_TOR_TOR_VIDEO_URL=
EDITORIAL_KOPI_SIDIKALANG_VIDEO_URL=
EDITORIAL_RUMAH_BOLON_VIDEO_URL=
EDITORIAL_BIKA_AMBON_VIDEO_URL=

# --- Tautan sosial media di footer (nama akun atau URL penuh; kosong = disembunyikan) ---
SOSIAL_INSTAGRAM=nsdiscovery.id
SOSIAL_YOUTUBE=nsdiscovery
SOSIAL_TIKTOK=nsdiscovery.id
SOSIAL_FACEBOOK="North Sumatra Discovery"

# --- Akun awal untuk "php artisan migrate --seed" (dipakai UserSeeder) ---
# Hanya untuk pengembangan lokal. Ganti bila dipakai di server sungguhan.
SEED_ADMIN_NAME="Admin North Sumatra Discovery"
SEED_ADMIN_EMAIL=admin@nsdiscovery.test
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_EMAIL=user@nsdiscovery.test
SEED_USER_PASSWORD=user1234

# --- Email: cukup dicatat ke log (tidak mengirim email sungguhan) ---
MAIL_MAILER=log

# --- (Opsional) YouTube untuk 4 Sorotan Editorial, sebagai ganti .mp4 di atas ---
# Kalau diisi, YouTube dipakai lebih dulu daripada .mp4.
EDITORIAL_TOR_TOR_YOUTUBE=
EDITORIAL_TOR_TOR_MULAI=0
EDITORIAL_TOR_TOR_SELESAI=30
EDITORIAL_KOPI_SIDIKALANG_YOUTUBE=
EDITORIAL_KOPI_SIDIKALANG_MULAI=0
EDITORIAL_KOPI_SIDIKALANG_SELESAI=30
EDITORIAL_RUMAH_BOLON_YOUTUBE=
EDITORIAL_RUMAH_BOLON_MULAI=0
EDITORIAL_RUMAH_BOLON_SELESAI=30
EDITORIAL_BIKA_AMBON_YOUTUBE=
EDITORIAL_BIKA_AMBON_MULAI=0
EDITORIAL_BIKA_AMBON_SELESAI=30

# --- Video YouTube latar header halaman Kuliner / Budaya / Destinasi (opsional) ---
HEADER_KULINER_YOUTUBE=
HEADER_BUDAYA_YOUTUBE=
HEADER_DESTINASI_YOUTUBE=
